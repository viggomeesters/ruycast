{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viggomeesters.github.io/schemas/repo-vision-contract.schema.json",
  "title": "Repo design vision contract",
  "description": "Agent-first repository product/design contract used by repo-complete and repo-design-vision.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "artifact_kind",
    "repo",
    "vision",
    "principles",
    "non_goals",
    "public_safety",
    "acceptance_scorecard",
    "review_checklist",
    "maturity_model",
    "residual_risk_wording"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://viggomeesters.github.io/schemas/repo-vision-contract.schema.json"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "artifact_kind": {
      "type": "string",
      "const": "repo_design_vision_contract"
    },
    "repo": {
      "type": "object",
      "required": ["name", "primary_users", "product_surface"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "primary_users": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "product_surface": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "vision": {
      "type": "object",
      "required": ["one_line", "north_star", "promise"],
      "properties": {
        "one_line": {"type": "string", "minLength": 1},
        "north_star": {"type": "string", "minLength": 1},
        "promise": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "principles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "title", "rule", "good", "bad"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "good": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "bad": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "public_safety": {
      "type": "object",
      "required": ["forbidden", "required_boundaries"],
      "properties": {
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "required_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "acceptance_scorecard": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "pass_condition"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "pass_condition": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "review_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "maturity_model": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level", "state", "meaning"],
        "properties": {
          "level": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "residual_risk_wording": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
